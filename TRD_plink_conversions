#!/bin/bash
#SBATCH -t 4-00:01 # total requested time the job may run in D-HH:MM
#SBATCH --cpus-per-task=5 # requests 4 threads/cpus per task. You can also set ntasks, but by default i>
#SBATCH --mem=15Gb # specify the amount of memory to request for the job
#SBATCH --output=%x.%j.out # specify the output file name. You can specify it however you want, but thi>



#Make a subdirectory in plink_trios for each chromosome
mkdir plink_trios

for CHR in {1..22} X Y; do
 mkdir plink_trios/chr${CHR}_trios
done

#Note that we set max alleles to 2 to keep things simple
for CHR in {1..22} X Y; do
 plink2 \
  --vcf trios_fast_vcf/chr${CHR}.trios.fast.vcf.gz \
  --set-all-var-ids 'chr@:#' \
  --make-bed \
  --out plink_trios/chr${CHR}_trios/chr${CHR}_trios \
  --max-alleles 2
done

#Manually replace the .fam file that plink2 makes with a hand made one since I di supply the the .ped
#Make sure all individuals have the "affected phenotype"
awk '
NR > 1 {
    child = $1
    father = $2
    mother = $3
    sex = $4

    fid = child

    if (!(father in seen)) {
        print fid, father, 0, 0, 1, 2
        seen[father] = 1
    }

    if (!(mother in seen)) {
        print fid, mother, 0, 0, 2, 2
        seen[mother] = 1
    }

    print fid, child, father, mother, sex, 2
    seen[child] = 1
}' pedigree_trios.txt > plink_trios/trios.fam
